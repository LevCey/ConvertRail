# Dashboard configuration. Every value has a working default — copy this file
# to .env.local only when you need to override one.

# Arc testnet access (defaults shown; contract addresses are compiled in)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app

# --- Which campaign to display -------------------------------------------
# Unset: falls back to demo.config.json, then to the last recorded run.
# CAMPAIGN_NAME=poc-demo-6

# --- Scan window ----------------------------------------------------------
# The dashboard scans chain events from the campaign's first block to the
# chain head. That is right while a run is live, but wrong for a finished
# campaign: the head keeps moving, so every request scans a growing stretch
# of empty blocks. The reference run below spans 611 blocks and ended at
# 53980200 — leaving this unset made a request take three minutes.
#
# Set both when deploying a finished campaign publicly:
# CAMPAIGN_FROM_BLOCK=53979589
# CAMPAIGN_TO_BLOCK=53980400
#
# Leave both unset when running against a live demo.

# --- Runtime evidence -----------------------------------------------------
# Payment and duplicate-attempt records. Resolution order: the paths below,
# then ./.e2e, then ../.e2e (a local demo run), then ./reference-run (the
# committed reference run, which is what a deployed build uses).
# Nothing here is trusted: payments are matched to their PayoutRecognized
# event and duplicate attempts are re-fetched from chain before display.
# CONVERTRAIL_RUNTIME_DIR=../.e2e
# PAYMENTS_LOG_PATH=
# FRAUD_LOG_PATH=
# RUN_LOG_PATH=
