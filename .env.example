# Arc testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app

# USDC on Arc testnet (ERC-20 interface, 6 decimals; native gas uses 18)
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Circle Gateway (Nanopayments)
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
GATEWAY_API_URL=https://gateway-api-testnet.circle.com

# Contract addresses (Arc testnet deployment, source-verified on arcscan)
AGENT_REGISTRY_ADDRESS=0x3A1F744d7F5B1F6E462727A8897CC88E273F730a
CONVERSION_REGISTRY_ADDRESS=0xbdb4e36DFb61A446Ec6900351b1A47754e389432
CAMPAIGN_ESCROW_ADDRESS=0x194aCFf27b8fbe332dab5ffba8d5318708d74520

# Demo funder (never commit a real value); actor keys are generated into
# gitignored .wallets.json by `npm run provision`.
FUNDER_PRIVATE_KEY=

# Demo acceptance target (provisioning and `npm run demo` use the same value)
E2E_TARGET_SETTLED=50
E2E_DEADLINE_MS=1800000
