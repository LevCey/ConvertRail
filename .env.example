# Arc testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app

# USDC on Arc testnet (ERC-20 interface, 6 decimals; native gas uses 18)
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Circle Gateway (Nanopayments)
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
GATEWAY_API_URL=https://gateway-api-testnet.circle.com

# Contract addresses (Arc testnet deployment, source-verified on arcscan)
AGENT_REGISTRY_ADDRESS=0xB76d859523f14D8cf66304086c727EE08bc5d449
CONVERSION_REGISTRY_ADDRESS=0x0Df89eAAa1abae9AE01558B7149604857e29B4Ca
CAMPAIGN_ESCROW_ADDRESS=0x1421cE35dD2Cb1Cc291eE1728B1AB091330acF2f

# Demo funder (never commit a real value); actor keys are generated into
# gitignored .wallets.json by `npm run provision`.
FUNDER_PRIVATE_KEY=

# Circle Wallets — optional. Set CIRCLE_WALLET_ID to have a Circle
# developer-controlled wallet sign the per-conversion payment authorizations
# instead of the local operational key; leave it empty to use the local key.
#
# CIRCLE_API_KEY and CIRCLE_ENTITY_SECRET may instead live in a `.env` one
# directory above this repository: the npm scripts load it first with
# --env-file-if-exists, so it is optional and values here win over it. Keeping
# the two real secrets outside the repository directory means they cannot be
# swept into an archive or a copy of the project folder. The wallet id and
# address belong here either way — they are not secrets, and their presence is
# what makes a missing secrets file fail loudly instead of quietly signing with
# the local key while the run claims a Circle wallet.
# The wallet must be an EOA (Gateway verifies EIP-3009 by ECDSA recovery) and
# is created on the virtual EVM-TESTNET chain, since Arc is not one of Circle's
# managed chains: Circle signs, this repository broadcasts. Provisioning credits
# its Gateway balance through depositFor, so the wallet never sends a
# transaction of its own.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=

# Demo acceptance target (provisioning and `npm run demo` use the same value)
E2E_TARGET_SETTLED=50
E2E_DEADLINE_MS=1800000

# Verified Suppression Receipts — off by default. Starting the watcher with
# SUPPRESSION_ENABLED unset performs no platform work at all: it records intent,
# signs SKIPPED receipts and touches no external API. Set it deliberately.
#
# SUPPRESSION_DRY_RUN defaults to true and must be set to the literal string
# "false" to allow a real request, so a half-configured environment cannot send
# anything to an advertiser's ad account.
SUPPRESSION_ENABLED=false
SUPPRESSION_DRY_RUN=true
SUPPRESSION_PLATFORM=mock
SUPPRESSION_MAX_ATTEMPTS=5
SUPPRESSION_SLA_SECONDS=300

# Key for the HMAC that commits a receipt to a buyer. At least 32 characters.
# Not the platform's identifier hash: that value is a global pseudonym anyone
# holding the same email can derive, whereas this one is scoped to the operator,
# so a published receipt links records within one advertiser and nowhere else.
# Losing this key loses linkability, which is the correct direction to fail in.
SUPPRESSION_COMMITMENT_KEY=

# secp256k1 key that signs suppression receipts. Separate from the operational
# and verifier keys: a receipt signer that can also move funds turns a leaked
# signing key into a financial incident rather than an evidence one.
SUPPRESSION_SIGNER_KEY=

# Bearer token the watcher presents to the merchant's suppression-subject
# endpoint. The endpoint refuses to serve at all when this is unset on the
# merchant side, so an unconfigured deployment releases no identities.
SUPPRESSION_SERVICE_TOKEN=

# Merchant signing address. Envelopes are authenticated against it before any
# identity in them is used, so a compromised or confused merchant cannot attach
# an arbitrary buyer to a verified claim.
MERCHANT_ADDRESS=

# Meta. Version pinned rather than tracking the newest release: a Graph API
# change that silently altered our request shape would change what a signed
# receipt attests to. v25.0 was released 2026-02-18 and is available until
# 2028-07-29. Verified against developers.facebook.com on 2026-08-04.
META_GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=
META_PIXEL_ID=
META_SUPPRESSION_AUDIENCE_ID=
META_AD_ACCOUNT_ID=
# Comma-separated acquisition ad sets that must exclude the suppression
# audience. Required when Meta is enabled; the watcher refuses to start without
# it. Without a declared scope the exclusion check has no denominator: it would
# report full coverage across whatever the account happened to return, while the
# campaign actually spending money sat outside the page it read.
META_ACQUISITION_AD_SET_IDS=
# Meta's own test mode: events land in Test Events and are excluded from
# optimisation and reporting. It scopes conversions only — the audience edge has
# no equivalent — so it cannot be combined with a live run, and both the adapter
# and the watcher refuse that configuration. Leave empty for a real send.
META_TEST_EVENT_CODE=
META_TIMEOUT_MS=15000
